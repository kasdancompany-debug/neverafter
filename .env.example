# Public site URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.neverafter.ca

# Newsletter / Starter Guide delivery. When unset, forms run in clearly labelled demo mode
# and no address is stored or sent anywhere.
# Any endpoint that accepts JSON { email, list, consent, consentText, timestamp } (e.g. a
# Zapier/Make hook or your own function in front of Buttondown, ConvertKit, Mailchimp).
NEWSLETTER_WEBHOOK_URL=

# Contact form delivery. Same contract: JSON POST of { name, email, topic, message }.
CONTACT_WEBHOOK_URL=

# Stripe Checkout. Checkout also stays disabled until a product is marked available in lib/products.ts.
STRIPE_SECRET_KEY=
