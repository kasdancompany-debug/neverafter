# Public site URL used for canonical URLs, sitemap, Open Graph and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.neverafter.ca

# ---------------------------------------------------------------------------
# PAYMENTS (Stripe) — both of these are required before checkout turns on.
# ---------------------------------------------------------------------------
# Stripe Dashboard → Developers → API keys. Use sk_test_… while testing, sk_live_… when you go live.
STRIPE_SECRET_KEY=
# Any long random string (32+ characters). Signs customers' access passes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and never change it after launch (changing it would lock existing buyers out).
ACCESS_TOKEN_SECRET=

# Optional: Stripe Dashboard → Developers → Webhooks → add endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: set to true once Stripe Tax is set up (Settings → Tax) to collect GST/HST automatically.
STRIPE_AUTOMATIC_TAX=false

# ---------------------------------------------------------------------------
# NEWSLETTER (Resend) — signup forms run in clearly labelled demo mode until set.
# ---------------------------------------------------------------------------
# Resend Dashboard → API Keys (needs "Sending" + "Contacts" access).
RESEND_API_KEY=
# A sender on a domain you have verified in Resend → Domains.
NEWSLETTER_FROM="Never After <brief@neverafter.ca>"
# Optional: where replies go.
NEWSLETTER_REPLY_TO=
# Optional: Resend segment ID to put new subscribers in (Audience → Segments).
RESEND_SEGMENT_ID=
# Required by Canada's anti-spam law (CASL) in commercial emails: your mailing address.
NEWSLETTER_POSTAL_ADDRESS=
# Optional: separate signing secret for confirmation links (falls back to ACCESS_TOKEN_SECRET).
NEWSLETTER_SECRET=

# Contact form delivery. JSON POST of { name, email, topic, message }.
CONTACT_WEBHOOK_URL=
